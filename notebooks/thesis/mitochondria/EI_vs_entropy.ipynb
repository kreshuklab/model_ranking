   "source": [
    "import matplotlib.pyplot as plt\n",
    "import numpy as np\n",
    "import math"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "id": "7612e47b",
   "metadata": {},
   "outputs": [],
   "source": [
    "a = np.arange(0,1,0.01)\n",
    "EI = []\n",
    "for p in a:\n",
    "    ei = math.sqrt(p*(1-p))\n",
    "    EI.append(ei)"
   ]
  },
